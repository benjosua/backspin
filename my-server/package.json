{
  "private": true,
  "name": "backspin-server",
  "version": "0.17.0",
  "description": "Backspin multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room backspin --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx \"test/**/*.test.ts\" --exit --timeout 15000",
    "start:prod": "node build/index.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/benjosua/backspin/issues"
  },
  "homepage": "https://github.com/benjosua/backspin#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "@types/pg": "^8.20.0",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/auth": "^0.17.9",
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "colyseus": "^0.17.6",
    "express": "^4.18.2",
    "pg": "^8.21.0"
  }
}
